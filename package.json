{
  "name": "@purea/wechat-devtools-mcp",
  "type": "module",
  "version": "0.0.2",
  "description": "微信小程序自动化 miniprogram-automator 的本地 MCP 服务器，将 SDK API 封装为 MCP 工具",
  "license": "MIT",
  "bin": {
    "wechat-devtools-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsdown --watch",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "miniprogram-automator": "^0.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@purea/eslint-config": "^0.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "jiti": "^2.7.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}
